{
  "config": {
    "step": {
      "user": {
        "description": "Connect to your Kermi x-center's Modbus/TCP interface. The heating-circuit and DHW storage-module units are optional and independent (project plan §10.1) — leave either blank if your installation doesn't have it.",
        "data": {
          "host": "Host",
          "port": "Port",
          "xcenter_unit": "x-center unit ID",
          "heating_circuit_unit": "Heating-circuit unit ID",
          "dhw_unit": "DHW unit ID"
        },
        "data_description": {
          "host": "IP address or hostname of the Kermi Modbus TCP gateway.",
          "port": "Modbus TCP port (usually 502).",
          "xcenter_unit": "Modbus unit/slave ID of the x-center controller (usually 40).",
          "heating_circuit_unit": "Modbus unit/slave ID of the heating-circuit storage module (usually 50). Leave blank if not present.",
          "dhw_unit": "Modbus unit/slave ID of the DHW storage module (usually 51). Leave blank if not present."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach one of the configured units. Check host/port and the unit IDs."
    },
    "abort": {
      "already_configured": "This device is already configured."
    }
  },
